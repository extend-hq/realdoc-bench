# Required for private HF datasets
HF_TOKEN=

# Anthropic Claude (agent)
ANTHROPIC_API_KEY=

# Google Gemini (agent)
GOOGLE_API_KEY=

# OpenAI (optional agent + layout processor)
OPENAI_API_KEY=

# Extend (parse provider)
EXTEND_API_KEY=

# Azure Document Intelligence
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# AWS Textract (uses default credential chain by default)
AWS_PROFILE=
AWS_REGION=us-east-1

# Reducto
REDUCTO_API_KEY=

# LlamaParse / LlamaCloud
LLAMA_CLOUD_API_KEY=

# Optional S3 mirror for layout blobs (alternative to HF)
REALDOC_BENCH_S3_BUCKET=
REALDOC_BENCH_S3_PROFILE=

# Self-hosted layout providers (Ray / vLLM endpoints, typically on awsl4)
PADDLE_STRUCTURE_BASE_URL=
PADDLE_STRUCTURE_AUTH_TOKEN=
PADDLE_OCR_VL_BASE_URL=
GLM_OCR_BASE_URL=
DOTS_OCR_BASE_URL=

# Dev overrides for the layout dataset loader (skip when running against the
# real HF dataset)
# REALDOC_BENCH_DATASET_EXTEND_AI_REALDOC_LAYOUT=/path/to/local/snapshot
# REALDOC_BENCH_SKIP_MISSING_BLOBS=1
