# Google Gemini (scorer + agent). Either name works; GEMINI_API_KEY wins if both set.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Extend (parse provider)
EXTEND_API_KEY=

# Azure Document Intelligence
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# AWS Textract (uses default credential chain by default)
AWS_PROFILE=
AWS_REGION=us-east-1

# Reducto
REDUCTO_API_KEY=

# LlamaParse / LlamaCloud
LLAMA_CLOUD_API_KEY=

# Mistral OCR 4
MISTRAL_API_KEY=
# Optional: override for self-hosted / proxied OCR endpoint.
MISTRAL_OCR_BASE_URL=

# Self-hosted layout providers (Ray / vLLM endpoints)
PADDLE_STRUCTURE_BASE_URL=
PADDLE_STRUCTURE_AUTH_TOKEN=
PADDLE_OCR_VL_BASE_URL=
DOTS_OCR_BASE_URL=
DOTS_OCR_API_KEY=

# Dev overrides for the layout dataset loader (skip when running against the
# real HF dataset)
# REALDOC_BENCH_DATASET_EXTEND_AI_REALDOCBENCH_LAYOUT=/path/to/local/snapshot
# REALDOC_BENCH_SKIP_MISSING_BLOBS=1
